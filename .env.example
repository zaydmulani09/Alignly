# ---------------------------------------------------------------------------
# Resume-to-Job Matcher - environment variables
# Copy this file to `.env.local` and fill in real values. Never commit .env.local
# ---------------------------------------------------------------------------

# Google Gemini API key. Required for AI analysis and the resume assistant.
# Get a free key at https://aistudio.google.com/apikey
# The app runs without it: upload, text extraction, editing and export all work,
# and the AI features report themselves as unconfigured instead of failing oddly.
GEMINI_API_KEY=

# Optional. Overrides the default model (gemini-3.5-flash). Verified alternatives:
# gemini-3.6-flash, gemini-3.5-flash-lite, gemini-3.1-flash-lite
GEMINI_MODEL=

# Optional. Max requests per IP per minute against the AI routes. Default: 10
AI_RATE_LIMIT_PER_MINUTE=

# Optional. Overrides the Gemini endpoint; used to exercise the AI routes
# against a local stub in development. Leave unset in production.
GEMINI_BASE_URL=
